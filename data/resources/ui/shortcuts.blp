using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: C_("shortcuts dialog", "General");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Show Preferences");
      action-name: "app.preferences";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Show Shortcuts");
      action-name: "app.shortcuts";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Close Window");
      action-name: "window.close";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Quit");
      action-name: "app.quit";
    }
  }

  Adw.ShortcutsSection {
    title: C_("shortcuts dialog", "View");

    Adw.ShortcutsItem {
      title: C_("shortcut view", "Increment Font Size");
      action-name: "win.increment-view-font-size";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut view", "Decrement Font Size");
      action-name: "win.decrement-view-font-size";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut view", "Reset Font Size");
      action-name: "win.reset-view-font-size";
    }
  }
}
