using Gtk 4.0;
using Adw 1;

template $AETContent: Adw.NavigationPage {
  title: _("Content");
  vexpand: true;
  hexpand: true;
  width-request: 800;
  height-request: 600;

  child: Adw.ToastOverlay toast_overlay {
    child: Adw.ViewStack stack {
      notify::visible-child => $on_visible_child_notify(template);

      Adw.ViewStackPage {
        name: "description";
        title: _("Description Formatter");

        child: $AETContentDescription description {};
      }

      Adw.ViewStackPage {
        name: "procedural";
        title: _("Procedural Generator");

        child: $AETContentProcedural procedural {};
      }

      Adw.ViewStackPage {
        name: "command_set";
        title: _("Command Set Generator");

        child: $AETContentCommandSet command_set {};
      }
    };
  };
}
